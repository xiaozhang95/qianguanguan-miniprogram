<view class="page">
  <view class="header">
    <view class="header-bg">
      <view class="header-circle c1"></view>
      <view class="header-circle c2"></view>
    </view>
    <view class="header-content header-content--form">
      <view class="nav-bar nav-bar--form" style="height:{{ app.offsetTop }}px">
        <view class="nav-back" bindtap="handleBack">
          <van-icon name="arrow-left" color="#fff" size="36rpx" />
          <text>返回</text>
        </view>
      </view>
      <text class="header-title">扫码登录</text>
    </view>
  </view>

  <view class="form-card">
    <view class="confirm-section">
      <image class="confirm-logo" src="{{ LOGO_BASE64 }}" mode="aspectFit" />
      <text class="confirm-title">确认登录</text>
      <text class="confirm-desc">将使用您的微信账号登录钱罐罐网页版</text>
    </view>
  </view>

  <view class="btn-wrap">
    <van-button custom-class="save-btn" block loading="{{ loading }}" bindtap="handleConfirm">
      确认登录
    </van-button>
  </view>
</view>
