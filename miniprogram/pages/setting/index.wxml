<view class="page">
  <view class="header">
    <view class="header-bg">
      <view class="header-circle c1"></view>
      <view class="header-circle c2"></view>
    </view>
    <view class="header-content">
      <view class="header-user" wx:if="{{ !app.userInfo }}">
        <image class="logo-placeholder" src="/assets/logo.png" mode="aspectFit"></image>
        <text class="login-btn" bindtap="handleToLogin">微信一键登录</text>
      </view>
      <view class="header-user" wx:else>
        <image class="avatar" wx:if="{{ app.userInfo.avatar }}" src="{{ app.userInfo.avatar }}" mode="aspectFill"></image>
        <image class="avatar" wx:else src="/assets/logo.png" mode="aspectFit"></image>
        <text class="greeting">您好，{{ app.userInfo.name || app.userInfo.username }}</text>
        <text class="role-tag">{{ app.userInfo.role === 'SUPER_ADMIN' ? '管理员' : '用户' }}</text>
      </view>
    </view>
  </view>

  <view class="stats-card">
    <view class="stats-item">
      <view class="stats-icon expense-icon">
        <text>出</text>
      </view>
      <view class="stats-info">
        <text class="stats-label">总支出</text>
        <text class="stats-value expense">￥{{ stats.expense }}</text>
      </view>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <view class="stats-icon income-icon">
        <text>入</text>
      </view>
      <view class="stats-info">
        <text class="stats-label">总收入</text>
        <text class="stats-value income">￥{{ stats.income }}</text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-card">
      <view class="menu-item" bindtap="handleToClassification">
        <view class="menu-icon icon-category">📂</view>
        <text class="menu-label">分类管理</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="handleToBook">
        <view class="menu-icon icon-book">📒</view>
        <text class="menu-label">账本管理</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-card">
      <view class="menu-item menu-share">
        <button plain="true" open-type="share" hover-class="none">
          <view class="menu-icon icon-share">💬</view>
          <text class="menu-label">分享给好友</text>
          <text class="menu-arrow">›</text>
        </button>
      </view>
      <view class="menu-item" wx:if="{{ app.userInfo }}" bindtap="handleToUser">
        <view class="menu-icon icon-profile">👤</view>
        <text class="menu-label">个人资料</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="menu-section" wx:if="{{ app.userInfo }}">
    <view class="menu-card">
      <view class="menu-item menu-item-exit" bindtap="handleToExitLogin">
        <view class="menu-icon icon-exit">🚪</view>
        <text class="menu-label">退出登录</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="footer">
    <text>钱罐罐 - 好好记账，天天向上</text>
  </view>
</view>
