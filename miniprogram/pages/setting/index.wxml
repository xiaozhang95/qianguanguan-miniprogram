<view class="page">
  <view class="header">
    <view class="header-bg">
      <view class="header-circle c1"></view>
      <view class="header-circle c2"></view>
    </view>
    <view class="header-content">
      <view class="header-row" wx:if="{{ !app.userInfo }}">
        <image class="header-logo" src="{{ LOGO_BASE64 }}" mode="aspectFit"></image>
        <view class="header-info">
          <text class="header-appname">钱罐罐</text>
          <text class="header-tagline">好好记账，天天向上</text>
        </view>
      </view>
      <view class="header-row" wx:else>
        <image class="header-avatar" wx:if="{{ avatar }}" src="{{ avatar }}" mode="aspectFill"></image>
        <view wx:else class="avatar-empty">
          <van-icon name="photograph" size="40rpx" color="#ccc" />
        </view>
        <view class="header-info">
          <text class="header-name">您好，{{ app.userInfo.name || app.userInfo.username }}</text>
          <text class="header-role">{{ app.userInfo.role === 'SUPER_ADMIN' ? '管理员' : app.userInfo.role === 'ADMIN' ? '管理员' : '普通用户' }}</text>
        </view>
      </view>
    </view>
  </view>

  <van-cell-group inset custom-class="menu-group menu-group--first">
    <van-cell wx:if="{{ app.userInfo }}" title="分享给好友" is-link>
      <van-icon slot="icon" name="share-o" size="36rpx" custom-class="menu-icon menu-icon-share" />
      <button class="share-btn" slot="right-icon" open-type="share" hover-class="none"></button>
    </van-cell>
    <van-cell wx:if="{{ app.userInfo }}" title="个人资料" is-link bind:click="handleToUser">
      <van-icon slot="icon" name="user-o" size="36rpx" custom-class="menu-icon menu-icon-profile" />
    </van-cell>
  </van-cell-group>

  <view wx:if="{{ !app.userInfo }}" class="login-action" bindtap="handleToLogin">
    <van-icon name="wechat" size="40rpx" color="#fff" />
    <text>一键登录</text>
  </view>

  <van-cell-group wx:if="{{ app.userInfo }}" inset custom-class="menu-group">
    <van-cell title="退出登录" is-link bind:click="handleToExitLogin">
      <van-icon slot="icon" name="revoke" size="36rpx" custom-class="menu-icon menu-icon-exit" />
    </van-cell>
  </van-cell-group>

  <view class="footer">
    <text>钱罐罐 - 好好记账，天天向上</text>
  </view>
</view>
