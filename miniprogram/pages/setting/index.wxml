<view class="page">
  <view class="header">
    <view class="header-bg">
      <view class="header-circle c1"></view>
      <view class="header-circle c2"></view>
    </view>
    <view class="header-content">
      <view class="header-row" wx:if="{{ !app.userInfo }}">
        <image class="header-logo" src="/assets/logo.png" mode="aspectFit"></image>
        <view class="header-info">
          <text class="header-appname">钱罐罐记账</text>
          <text class="header-tagline">好好记账，天天向上</text>
        </view>
      </view>
      <view class="header-row" wx:else>
        <image class="header-avatar" wx:if="{{ app.userInfo.avatar }}" src="{{ config.url + app.userInfo.avatar }}" mode="aspectFill"></image>
        <view wx:else class="avatar-empty">
          <van-icon name="photograph" size="40rpx" color="#ccc" />
        </view>
        <view class="header-info">
          <text class="header-name">您好，{{ app.userInfo.name || app.userInfo.username }}</text>
          <text class="header-role">{{ app.userInfo.role === Role.SUPER_ADMIN || app.userInfo.role === Role.ADMIN ? RoleLabel[Role.SUPER_ADMIN] : RoleLabel[Role.USER] }}</text>
        </view>
      </view>
    </view>
  </view>

  <van-cell-group inset custom-class="menu-group menu-group--first">
    <van-cell wx:if="{{ app.userInfo }}" title="个人资料" is-link bind:click="handleToUser">
      <van-icon slot="icon" name="user-o" size="36rpx" custom-class="menu-icon menu-icon-profile" />
    </van-cell>
    <van-cell title="分享给好友" is-link custom-class="share-cell">
      <van-icon slot="icon" name="share-o" size="36rpx" custom-class="menu-icon menu-icon-share" />
      <button class="share-btn" open-type="share" hover-class="none"></button>
    </van-cell>
    <van-cell title="网页版" is-link bind:click="handleToWeb">
      <van-icon slot="icon" name="link-o" size="36rpx" custom-class="menu-icon menu-icon-web" />
    </van-cell>
    <van-cell title="用户服务协议" is-link bind:click="handleToAgreement">
      <van-icon slot="icon" name="description-o" size="36rpx" custom-class="menu-icon menu-icon-agreement" />
    </van-cell>
    <van-cell title="隐私政策" is-link bind:click="handleToPrivacy">
      <van-icon slot="icon" name="shield-o" size="36rpx" custom-class="menu-icon menu-icon-privacy" />
    </van-cell>
  </van-cell-group>

  <view wx:if="{{ !app.userInfo }}" class="login-action" bindtap="handleToLogin">
    <van-icon name="wechat" size="40rpx" color="#fff" />
    <text>一键登录</text>
  </view>

  <view class="footer">
    <text>—— 钱罐罐记账 ——</text>
  </view>
</view>
