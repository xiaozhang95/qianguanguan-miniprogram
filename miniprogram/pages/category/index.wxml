<view class="page" catchtouchmove="{{ showForm ? 'onPrevent' : '' }}">
  <fixed-nav-bar id="fixed-nav" title="分类管理" app="{{ app }}" />

  <view class="header">
    <view class="header-bg">
      <view class="header-circle c1"></view>
      <view class="header-circle c2"></view>
    </view>
    <view class="header-content">
      <view class="nav-bar" style="height:{{ app.offsetTop }}px">
        <text class="nav-title">分类管理</text>
      </view>
    </view>
  </view>

  <view class="stats-group">
    <view class="stats-card">
      <view class="stats-item">
        <view class="stats-header">
          <text class="stats-icon expense-icon">▼</text>
          <text class="stats-label">支出分类</text>
        </view>
        <text class="stats-value expense">{{ expenseCount }}</text>
      </view>
      <view class="stats-item">
        <view class="stats-header">
          <text class="stats-icon income-icon">▲</text>
          <text class="stats-label">收入分类</text>
        </view>
        <text class="stats-value income">{{ incomeCount }}</text>
      </view>
      <view class="stats-item">
        <view class="stats-header">
          <text class="stats-icon balance-zero">◆</text>
          <text class="stats-label">全部分类</text>
        </view>
        <text class="stats-value balance-zero">{{ totalCount }}</text>
      </view>
    </view>
  </view>
  <filter-tabs tabs="{{ filterTabs }}" active-index="{{ activeTab }}" bind:change="onFilterTabChange" />

  <loading-block loading="{{ loading }}" />

  <block wx:if="{{ !loading }}">
    <view wx:if="{{ filteredCategories.length > 0 }}" class="cat-list-wrap">
      <block wx:if="{{ customCategories.length > 0 }}">
        <view class="cat-section-title">
          <text class="cat-section-label">自定义分类</text>
          <text class="cat-section-count">{{ customCategories.length }}</text>
        </view>
        <view class="cat-section">
          <block wx:for="{{ customCategories }}" wx:key="id">
            <van-swipe-cell
              right-width="{{ 160 }}"
              custom-class="cat-swipe"
            >
              <view class="cat-row" bindtap="onEdit" data-cat="{{ item }}">
                <view class="cat-left">
                  <image wx:if="{{ item.iconIsImage }}" class="cat-icon-img" src="{{ item.icon }}" mode="aspectFill"></image>
                  <text wx:else class="cat-icon">{{ item.icon }}</text>
                  <text class="cat-name">{{ item.name }}</text>
                </view>
                <view class="cat-right">
                  <view class="cat-tag {{ item.type === BillType.INCOME ? 'income' : 'expense' }}">
                    <text>{{ item.type === BillType.INCOME ? '收入' : '支出' }}</text>
                  </view>
                  <view class="cat-tag custom">自定义</view>
                </view>
              </view>
              <view slot="right" class="swipe-actions">
                <view class="swipe-btn swipe-edit" bindtap="onEdit" data-cat="{{ item }}">编辑</view>
                <view class="swipe-btn swipe-delete" bindtap="onDelete" data-id="{{ item.id }}">删除</view>
              </view>
            </van-swipe-cell>
          </block>
        </view>
      </block>

      <block wx:if="{{ systemCategories.length > 0 }}">
        <view class="cat-section-title">
          <text class="cat-section-label">系统分类</text>
          <text class="cat-section-count">{{ systemCategories.length }}</text>
        </view>
        <view class="cat-section">
          <block wx:for="{{ systemCategories }}" wx:key="id">
            <view class="cat-row cat-row-system" bindtap="onSystemTap">
              <view class="cat-left">
                <image wx:if="{{ item.iconIsImage }}" class="cat-icon-img" src="{{ item.icon }}" mode="aspectFill"></image>
                <text wx:else class="cat-icon">{{ item.icon }}</text>
                <text class="cat-name">{{ item.name }}</text>
              </view>
              <view class="cat-right">
                <view class="cat-tag {{ item.type === BillType.INCOME ? 'income' : 'expense' }}">
                  <text>{{ item.type === BillType.INCOME ? '收入' : '支出' }}</text>
                </view>
                <view class="cat-tag system">默认</view>
              </view>
            </view>
          </block>
        </view>
      </block>
    </view>
    <van-empty wx:else description="暂无分类" />
  </block>

  <fab-button bind:tap="onAdd" />

  <van-popup show="{{ showForm }}" position="bottom" bind:close="onFormClose" round custom-class="form-popup" lock-scroll>
    <view class="form-wrap">
      <view class="form-header">
        <text class="form-title">{{ editingCategory ? '编辑分类' : '新增分类' }}</text>
        <van-icon name="cross" size="40rpx" color="#999" bindtap="onFormClose" />
      </view>

      <view class="form-type">
        <view
          class="type-tab {{ formType === BillType.EXPENSE ? 'active expense' : '' }}"
          bindtap="onFormTypeChange"
          data-type="{{ BillType.EXPENSE }}"
        >支出</view>
        <view
          class="type-tab {{ formType === BillType.INCOME ? 'active income' : '' }}"
          bindtap="onFormTypeChange"
          data-type="{{ BillType.INCOME }}"
        >收入</view>
      </view>

      <view class="form-field">
        <text class="field-label">名称</text>
        <input
          class="field-input"
          value="{{ formName }}"
          placeholder="如：餐饮"
          maxlength="50"
          bindinput="onNameInput"
        />
      </view>

      <view class="form-field form-field--icon">
        <text class="field-label">图标</text>
        <view class="icon-pick-wrap">
          <view wx:if="{{ formIconFile }}" class="icon-preview">
            <image class="icon-preview-img" src="{{ formIconFile }}" mode="aspectFill"></image>
            <view class="icon-preview-remove" bindtap="onRemoveIcon">
              <van-icon name="cross" size="24rpx" color="#fff" />
            </view>
          </view>
          <view wx:else class="icon-actions">
            <input
              class="field-input"
              value="{{ formIcon }}"
              placeholder="如：🍜"
              maxlength="500"
              bindinput="onIconInput"
            />
            <view class="icon-upload-btn" bindtap="onChooseIcon">
              <van-icon name="photograph" size="36rpx" color="#1677ff" />
            </view>
          </view>
        </view>
      </view>

      <view class="form-field">
        <text class="field-label">排序</text>
        <input
          class="field-input"
          type="number"
          value="{{ formSort }}"
          bindinput="onSortChange"
        />
      </view>

      <van-button
        custom-class="save-btn"
        block
        loading="{{ saving }}"
        bindtap="onFormSubmit"
      >保存</van-button>
    </view>
  </van-popup>
</view>
