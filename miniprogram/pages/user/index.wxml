<view class="page">
  <view class="header">
    <view class="header-bg">
      <view class="header-circle c1"></view>
      <view class="header-circle c2"></view>
    </view>
    <view class="header-content header-content--form">
      <view class="nav-bar nav-bar--form" style="height:{{ app.offsetTop }}px">
        <view class="nav-back" bindtap="handleBack">
          <van-icon name="arrow-left" color="#fff" size="36rpx" />
          <text>返回</text>
        </view>
      </view>
      <text class="header-title">编辑个人资料</text>
    </view>
  </view>

  <view class="form-card">
    <view class="avatar-row">
      <text class="avatar-label">头像</text>
      <button class="avatar-btn" open-type="chooseAvatar" hover-class="none" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{ avatar }}" src="{{ avatar }}" mode="aspectFill"></image>
        <view wx:else class="avatar-empty">
          <van-icon name="photograph" size="40rpx" color="#ccc" />
        </view>
      </button>
    </view>

    <view class="form-field">
      <text class="field-label">昵称</text>
      <input class="field-input" type="nickname" value="{{ name }}" placeholder="请输入昵称" bindinput="onNameInput" bindblur="onNameInput" />
    </view>
    <view class="form-field">
      <text class="field-label">邮箱</text>
      <input class="field-input" value="{{ email }}" placeholder="请输入邮箱" bindinput="onEmailInput" />
    </view>
    <view class="form-field" wx:if="{{ emailChanged }}">
      <text class="field-label">验证码</text>
      <input class="field-input email-code-input" value="{{ emailCode }}" placeholder="请输入验证码" bindinput="onEmailCodeInput" />
      <van-button
        custom-class="send-code-btn"
        loading="{{ sendCodeLoading }}"
        disabled="{{ codeCountdown > 0 }}"
        size="small"
        bindtap="handleSendCode"
      >
        {{ codeCountdown > 0 ? codeCountdown + 's' : '发送' }}
      </van-button>
    </view>
  </view>

  <view class="agreement-check">
    <van-checkbox value="{{ agreed }}" bind:change="onAgreeChange" icon-size="32rpx" checked-color="#1677ff" />
    <view class="agreement-text">
      <text>已阅读并同意</text>
      <text class="agreement-link" bindtap="handleToService">《用户服务协议》</text>
      <text>和</text>
      <text class="agreement-link" bindtap="handleToPrivacy">《隐私政策》</text>
    </view>
  </view>

  <view class="btn-wrap">
    <van-button custom-class="save-btn" block loading="{{ saving }}" bindtap="handleSave">保存</van-button>
  </view>
</view>
