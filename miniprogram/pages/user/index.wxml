<view class="page">
  <view class="header">
    <view class="header-bg">
      <view class="header-circle c1"></view>
      <view class="header-circle c2"></view>
    </view>
    <view class="header-content">
      <view class="nav-bar" style="height:{{ app.offsetTop }}px">
        <view class="nav-back" bindtap="handleBack">
          <van-icon name="arrow-left" color="#fff" size="36rpx" />
          <text>返回</text>
        </view>
      </view>
      <text class="header-title">编辑个人资料</text>
    </view>
  </view>

  <view class="form-card">
    <view class="avatar-row">
      <text class="avatar-label">头像</text>
      <button class="avatar-btn" open-type="chooseAvatar" hover-class="none" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{ avatar }}" src="{{ avatar }}" mode="aspectFill"></image>
        <view wx:else class="avatar-empty">
          <van-icon name="photograph" size="40rpx" color="#ccc" />
        </view>
      </button>
    </view>

    <view class="form-field">
      <text class="field-label">昵称</text>
      <input class="field-input" type="nickname" value="{{ name }}" placeholder="请输入昵称" bindinput="onNameInput" bindblur="onNameInput" />
    </view>
    <view class="form-field">
      <text class="field-label">手机号</text>
      <input class="field-input" type="number" value="{{ phone }}" placeholder="请输入手机号" bindinput="onPhoneInput" />
    </view>
    <view class="form-field">
      <text class="field-label">邮箱</text>
      <input class="field-input" value="{{ email }}" placeholder="请输入邮箱" bindinput="onEmailInput" />
    </view>
  </view>

  <view class="btn-wrap">
    <van-button custom-class="save-btn" block bindtap="handleSave">保存</van-button>
  </view>
</view>
