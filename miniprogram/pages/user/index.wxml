<view class="page">
  <view class="header">
    <view class="header-bg">
      <view class="header-circle c1"></view>
      <view class="header-circle c2"></view>
    </view>
    <view class="header-content">
      <view class="header-back" bindtap="handleBack">
        <van-icon name="arrow-left" color="#fff" size="36rpx" />
        <text>返回</text>
      </view>
      <text class="header-title">编辑个人资料</text>
    </view>
  </view>

  <view class="form-card">
    <view class="avatar-row">
      <text class="avatar-label">头像</text>
      <button class="avatar-btn" open-type="chooseAvatar" hover-class="none" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{ avatar }}" src="{{ avatar }}" mode="aspectFill"></image>
        <view wx:else class="avatar-empty">
          <van-icon name="photograph" size="40rpx" color="#ccc" />
        </view>
      </button>
    </view>

    <van-field
      label="昵称"
      value="{{ name }}"
      placeholder="请输入昵称"
      border="{{ false }}"
      bind:change="onNameInput"
    />
    <van-field
      label="手机号"
      type="number"
      value="{{ phone }}"
      placeholder="请输入手机号"
      border="{{ false }}"
      bind:change="onPhoneInput"
    />
    <van-field
      label="邮箱"
      value="{{ email }}"
      placeholder="请输入邮箱"
      border="{{ false }}"
      bind:change="onEmailInput"
    />
  </view>

  <view class="btn-wrap">
    <van-button type="primary" block round bindtap="handleSave">保存</van-button>
  </view>
</view>
